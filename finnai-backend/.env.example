APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://finnai:finnai@db:5432/finnai
DATABASE_URL_SYNC=postgresql+psycopg://finnai:finnai@db:5432/finnai

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

INVITE_EXPIRE_DAYS=7

AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SCORE_DEBOUNCE_SECONDS=600
